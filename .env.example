# =============================================================================
# Variáveis de Ambiente — Instituto Fiscaliza Brasil
# NUNCA commitar o .env real. Copie este arquivo para .env e preencha.
# =============================================================================

# --- Aplicação ---
APP_ENV=development
APP_NAME=Instituto Fiscaliza Brasil
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000/api/v1

# --- Banco de Dados ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ifb
POSTGRES_USER=ifb
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Autenticação (JWT) ---
JWT_SECRET=GENERATE_A_SECURE_RANDOM_STRING
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Rate Limiting ---
# Configurado internamente no código via RATE_LIMITS dict
# Usa Redis automaticamente

# --- OpenAI (classificação de notícias) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- APIs Externas ---
TSE_API_URL=https://divulgacandcontas.tse.jus.br/divulga/rest/v1
CAMARA_API_URL=https://dadosabertos.camara.leg.br/api/v2
SENADO_API_URL=https://legis.senado.leg.br/dadosabertos
TRANSPARENCIA_API_URL=https://api.portaldatransparencia.gov.br/api-de-dados
TRANSPARENCIA_API_KEY=

# --- Notícias ---
NEWS_API_KEY=
GDELT_API_URL=https://api.gdeltproject.org/api/v2
BING_NEWS_API_KEY=

# --- Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ifb

# --- E-mail (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fiscalizabrasil.org.br

# --- Monitoramento ---
SENTRY_DSN=

# --- Pagamentos ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
